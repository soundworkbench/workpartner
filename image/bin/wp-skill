#!/usr/bin/python3
"""Manage personal skills shared by Claude Code and Codex; run as the container owner."""
import argparse
import base64
import fcntl
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import tempfile
import zipfile

import yaml

NAME = re.compile(r"^[a-z0-9-]+$")
SOURCE_URL = re.compile(r"https://[^\s\"'<>]+")
MAX_UPLOAD = 10 * 1024 * 1024
# A small compressed file must not exhaust the personal volume during extraction.
MAX_EXPANDED = 100 * 1024 * 1024


class SkillError(Exception):
    def __init__(self, code, message, **extra):
        self.result = {"error": code, "message": message, **extra}


def reject(code, message, **extra):
    raise SkillError(code, message, **extra)


def metadata(source):
    match = re.match(r"\A\ufeff?---\r?\n(.*?)\r?\n---(?:\r?\n|$)", source, re.S)
    try:
        meta = yaml.safe_load(match[1] + '\n') if match else None
    except yaml.YAMLError:
        meta = None
    if not isinstance(meta, dict) or not isinstance(meta.get("name"), str) or not NAME.fullmatch(meta["name"]):
        reject("invalid_name", "技能名称只能包含小写字母、数字和连字符。")
    row = {"name": meta["name"], "description": str(meta.get("description") or "")}
    extra = meta.get("metadata") if isinstance(meta.get("metadata"), dict) else {}
    name, url = extra.get("source-name"), extra.get("source-url")
    if isinstance(name, str) and 0 < len(name.strip()) <= 80 and isinstance(url, str) and SOURCE_URL.fullmatch(url):
        row["source"] = {"name": name.strip(), "url": url}
    return row


class SkillStore:
    def __init__(self, home=Path('/data'), builtin=Path('/opt/workpartner/skills'),
                 translations=Path('/opt/workpartner/skills-zh.json'), uploads=Path('/data/.wp-skill-uploads'), shared=None):
        self.shared = Path(shared or os.environ.get('WORKPARTNER_SHARED_SKILLS', '/opt/shared-skills'))
        self.skills = home / '.claude/skills'
        self.codex = home / '.codex/skills'
        self.builtin, self.uploads = builtin, uploads.resolve()
        self.zh = json.loads(translations.read_text())
        manifest = builtin / '.wp-feishu-skills.json'
        self.feishu = set(json.loads(manifest.read_text())) if manifest.exists() else set()
        self.promoted = set(json.loads(os.environ.get('WORKPARTNER_MARKET_PREINSTALLED', '[]')))
        self.protected = self.promoted | set(self.zh) | {p.name for p in builtin.iterdir() if p.is_dir()}

    def run(self, action, value=None, overwrite=False):
        self.skills.mkdir(parents=True, exist_ok=True)
        self.codex.mkdir(parents=True, exist_ok=True)
        with (self.skills.parent / '.wp-skills.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if action == 'list':
                return self.list()
            if action == 'export':
                return self.export(value)
            if action == 'shared-install':
                return self.shared_install(value)
            if action == 'install':
                return self.install(value, overwrite)
            return self.delete(value)

    def list(self):
        rows = []
        for directory in sorted(self.skills.iterdir()):
            if directory.name in self.feishu and directory.name != "feishu":
                continue
            if not NAME.fullmatch(directory.name) or (directory.is_symlink() and not self.shared_link(directory)):
                continue
            file = directory / 'SKILL.md'
            if self.shared_link(directory) and not file.is_file():
                rows.append({'id': directory.name, 'name': directory.name, 'description': '',
                             'preinstalled': directory.name in self.protected, 'shared': True, 'withdrawn': True,
                             'displayName': directory.name, 'displayDescription': ''})
                continue
            if not directory.is_dir() or not file.is_file() or file.is_symlink():
                continue
            meta = metadata(file.read_text(encoding='utf-8'))
            preinstalled = directory.name in self.protected
            zh = self.zh.get(meta['name'], {}) if preinstalled else {}
            rows.append({"id": directory.name, **meta, "preinstalled": preinstalled, "shared": directory.is_symlink(),
                         "displayName": zh.get('name', meta['name']),
                         "displayDescription": zh.get('description', meta['description'])})
        return {"skills": sorted(rows, key=lambda row: (not row['preinstalled'], row['id']))}

    def mutable(self, name, promoted=False):
        if not isinstance(name, str) or not NAME.fullmatch(name):
            reject('invalid_name', '技能名称只能包含小写字母、数字和连字符。')
        if name in self.protected and not (promoted and name in self.promoted):
            reject('preinstalled', '预装技能不能覆盖或删除。')
        directory, link = self.skills / name, self.codex / name
        if (directory.is_symlink() and not self.shared_link(directory)) or (directory.exists() and not directory.is_dir()):
            reject('unsafe_target', '现有技能目录无法安全修改，请联系管理员。')
        if link.exists() and not link.is_symlink():
            reject('unsafe_target', '现有 ChatGPT 技能目录需要管理员核对，未作修改。')
        return directory, link

    def install(self, uploaded, overwrite):
        source = Path(uploaded).resolve()
        if not source.is_relative_to(self.uploads) or not source.is_file():
            reject('invalid_upload', '请选择本人上传的技能文件。')
        if source.stat().st_size > MAX_UPLOAD:
            reject('too_large', '技能文件不能超过 10 MB。')
        with tempfile.TemporaryDirectory(prefix='.wp-skill-', dir=self.skills.parent) as temporary:
            stage = Path(temporary) / 'new'
            stage.mkdir()
            if source.suffix.lower() == '.zip':
                self.extract(source, stage)
            elif source.suffix.lower() == '.md':
                shutil.copyfile(source, stage / 'SKILL.md')
            else:
                reject('invalid_upload', '请选择 .zip 或 SKILL.md 文件。')
            file = stage / 'SKILL.md'
            if not file.is_file():
                reject('missing_skill', '技能包根目录或一层子目录中需要有 SKILL.md。')
            meta = metadata(file.read_text(encoding='utf-8'))
            name = meta['name']
            directory, link = self.mutable(name)
            if directory.is_symlink():
                reject('shared_skill', '请先卸载公司技能，再添加自己的同名技能。')
            if directory.exists() and not overwrite:
                reject('exists', '已有同名技能，是否覆盖？', name=name)
            backup = Path(temporary) / 'old'
            staged_link = Path(temporary) / 'link'
            staged_link.symlink_to(directory)
            existed = directory.exists()
            if existed:
                directory.rename(backup)
            try:
                stage.rename(directory)
                os.replace(staged_link, link)
            except OSError:
                if directory.exists():
                    shutil.rmtree(directory)
                if existed:
                    backup.rename(directory)
                raise
        return {"name": name}

    def shared_link(self, directory):
        # Compare the immediate destination, including dangling links after withdrawal.
        return directory.is_symlink() and Path(os.readlink(directory)) == self.shared / 'live' / directory.name

    def shared_install(self, name):
        directory, link = self.mutable(name, promoted=True)
        target = self.shared / 'live' / name
        if not (target / 'SKILL.md').is_file():
            reject('not_found', '这个技能已经下架，请刷新市场。')
        if directory.exists() and not directory.is_symlink():
            reject('exists', '本人已有同名技能，请先改名。', name=name)
        changed = not directory.is_symlink()
        if changed:
            directory.symlink_to(target)
        with tempfile.TemporaryDirectory(prefix='.wp-link-', dir=self.skills.parent) as temporary:
            staged = Path(temporary) / 'link'
            staged.symlink_to(directory)
            try:
                os.replace(staged, link)
            except OSError:
                if changed:
                    directory.unlink()
                raise
        return {'name': name, 'changed': changed}

    def export(self, name):
        directory, _ = self.mutable(name)
        if directory.is_symlink() or not directory.is_dir():
            reject('not_found', '请选择自己制作的技能。')
        files, size = [], 0
        for root, directories, names in os.walk(directory, followlinks=False):
            if any((Path(root) / child).is_symlink() for child in directories):
                reject('unsafe_archive', '技能不能包含软链接。')
            for child in names:
                source = Path(root) / child
                relative = source.relative_to(directory).as_posix()
                if any(part in ('.', '..') or ':' in part or '\\' in part for part in Path(relative).parts):
                    reject('unsafe_archive', '技能文件路径无效。')
                # O_NOFOLLOW rejects file links even when changed during the scan.
                fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(fd, 'rb') as reader:
                    info = os.fstat(reader.fileno())
                    if not stat.S_ISREG(info.st_mode):
                        reject('unsafe_archive', '技能只能包含普通文件。')
                    content = reader.read(MAX_UPLOAD + 1)
                size += len(content)
                if size > MAX_UPLOAD or len(files) >= 200:
                    reject('too_large', '分享的技能最多 200 个文件、总计 10 MB。')
                files.append({'path': relative, 'content': base64.b64encode(content).decode(),
                              'executable': bool(info.st_mode & 0o111)})
        text = next((base64.b64decode(f['content']).decode('utf-8') for f in files if f['path'] == 'SKILL.md'), '')
        meta = metadata(text)
        if meta['name'] != name:
            reject('invalid_name', '技能目录名与说明中的名称不一致。')
        return {**meta, 'files': files}

    def extract(self, source, stage):
        with zipfile.ZipFile(source) as archive:
            entries = archive.infolist()
            files = [entry for entry in entries if not entry.is_dir()]
            if len(files) > 200:
                reject('too_many_files', '技能包最多包含 200 个文件。')
            for entry in entries:
                name = entry.filename
                if (not name or '\\' in name or '\x00' in name or PurePosixPath(name).is_absolute()
                        or '..' in name.split('/') or ':' in name.split('/')[0]):
                    reject('unsafe_archive', '技能包不能包含上级路径或绝对路径。')
                mode = entry.external_attr >> 16
                if stat.S_ISLNK(mode) or stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFDIR):
                    reject('unsafe_archive', '技能包不能包含软链接或特殊文件。')
            candidates = [entry for entry in files if PurePosixPath(entry.filename).name == 'SKILL.md'
                          and len(PurePosixPath(entry.filename).parts) <= 2]
            if len(candidates) != 1:
                reject('missing_skill', '技能包根目录或一层子目录中需要有唯一的 SKILL.md。')
            root = PurePosixPath(candidates[0].filename).parent
            if sum(entry.file_size for entry in files) > MAX_EXPANDED:
                reject('too_large', '技能包解压后过大，请精简后重试。')
            for entry in files:
                relative = PurePosixPath(entry.filename)
                if not relative.is_relative_to(root):
                    continue  # ZIP tools may add metadata alongside the single skill folder.
                target = stage / str(relative.relative_to(root))
                target.parent.mkdir(parents=True, exist_ok=True)
                with archive.open(entry) as reader, target.open('xb') as writer:
                    shutil.copyfileobj(reader, writer)
                # Keep executable scripts usable without restoring special permission bits.
                target.chmod(0o755 if entry.external_attr >> 16 & 0o111 else 0o644)

    def delete(self, name):
        directory, link = self.mutable(name)
        if directory.is_symlink() and self.shared_link(directory):
            directory.unlink()
            if link.is_symlink():
                link.unlink()
            return {'name': name, 'shared': True}
        if not directory.is_dir():
            reject('not_found', '没有找到这个技能，请刷新列表。')
        # Move both entries out of the engine search paths before removing owned files.
        with tempfile.TemporaryDirectory(prefix='.wp-skill-', dir=self.skills.parent) as temporary:
            backup = Path(temporary) / 'old'
            directory.rename(backup)
            try:
                if link.is_symlink():
                    link.unlink()
            except OSError:
                backup.rename(directory)
                raise
        return {"name": name}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('action', choices=['list', 'install', 'delete', 'export', 'shared-install'])
    parser.add_argument('value', nargs='?')
    parser.add_argument('--overwrite', action='store_true')
    args = parser.parse_args()
    try:
        result = SkillStore().run(args.action, args.value, args.overwrite)
    except SkillError as error:
        result = error.result
    except (OSError, ValueError, TypeError, RuntimeError, zipfile.BadZipFile, UnicodeError):
        result = {"error": "invalid_skill", "message": "技能文件无法处理，未确认完成，请检查文件后重试。"}
    print(json.dumps(result, ensure_ascii=False))


if __name__ == '__main__':
    main()
