{
  "apiVersion": "v1",
  "kind": "Namespace",
  "metadata": {"name": {{systemNamespace}}, "labels": {{partOf}}}
}
---
{
  "apiVersion": "v1",
  "kind": "Namespace",
  "metadata": {
    "name": {{namespace}},
    "labels": {
      "app.kubernetes.io/part-of": "workpartner",
      "pod-security.kubernetes.io/enforce": "baseline",
