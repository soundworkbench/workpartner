{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "wp-asr", "namespace": {{systemNamespace}}, "labels": {{asrLabels}}},
  "spec": {
    "replicas": 1,
    "strategy": {"type": "Recreate"},
    "selector": {"matchLabels": {{asrLabels}}},
    "template": {
      "metadata": {"labels": {{asrLabels}}},
      "spec": {
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "nodeSelector": {{asrNodeSelector}},
        "securityContext": {"runAsNonRoot": true, "runAsUser": 10001, "runAsGroup": 10001, "seccompProfile": {"type": "RuntimeDefault"}},
        "containers": [{
          "name": "asr",
          "image": {{asrImage}},
          "imagePullPolicy": "Never",
          "securityContext": {
            "runAsNonRoot": true,
            "readOnlyRootFilesystem": true,
            "allowPrivilegeEscalation": false,
            "capabilities": {"drop": ["ALL"]}
          },
          "env": [{"name": "ASR_THREADS", "value": {{asrThreads}}}],
          "ports": [{"name": "http", "containerPort": 8080, "protocol": "TCP"}],
          "resources": {
            "requests": {"cpu": "500m", "memory": "1Gi"},
            "limits": {"cpu": "2", "memory": "2Gi"}
          },
          "startupProbe": {"httpGet": {"path": "/healthz", "port": "http"}, "periodSeconds": 5, "failureThreshold": 60, "timeoutSeconds": 2},
          "readinessProbe": {"httpGet": {"path": "/healthz", "port": "http"}, "initialDelaySeconds": 30, "periodSeconds": 5, "timeoutSeconds": 2},
          "livenessProbe": {"httpGet": {"path": "/healthz", "port": "http"}, "initialDelaySeconds": 120, "periodSeconds": 10, "timeoutSeconds": 2}
        }]
      }
    }
  }
}
---
{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {"name": "wp-asr", "namespace": {{systemNamespace}}, "labels": {{asrLabels}}},
  "spec": {
    "type": "ClusterIP",
    "selector": {{asrLabels}},
    "ports": [{"name": "http", "port": 8080, "targetPort": 8080, "protocol": "TCP"}]
  }
}
---
{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {"name": "wp-asr", "namespace": {{systemNamespace}}, "labels": {{asrLabels}}},
  "spec": {
    "podSelector": {"matchLabels": {{asrLabels}}},
    "policyTypes": ["Ingress", "Egress"],
    "ingress": [{
      "from": [{"podSelector": {"matchLabels": {{gatewayLabels}}}}],
      "ports": [{"protocol": "TCP", "port": 8080}]
    }],
    "egress": []
  }
}
