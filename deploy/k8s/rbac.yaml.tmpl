{
  "apiVersion": "v1",
  "kind": "ServiceAccount",
  "metadata": {"name": {{gatewayName}}, "namespace": {{systemNamespace}}, "labels": {{partOf}}}
}
---
{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {"name": "workpartner-users", "namespace": {{namespace}}, "labels": {{partOf}}},
  "rules": [
    {"apiGroups": ["apps"], "resources": ["statefulsets"], "verbs": ["get", "list", "create", "update", "patch", "delete"]},
    {"apiGroups": [""], "resources": ["pods"], "verbs": ["get", "list", "create", "delete"]},
    {"apiGroups": [""], "resources": ["pods/exec"], "verbs": ["get", "create"]},
    {"apiGroups": [""], "resources": ["pods/log"], "verbs": ["get"]},
    {"apiGroups": [""], "resources": ["secrets"], "verbs": ["get", "create", "update", "patch"]},
    {"apiGroups": [""], "resources": ["persistentvolumeclaims"], "verbs": ["get", "create"]},
    {"apiGroups": ["networking.k8s.io"], "resources": ["networkpolicies"], "verbs": ["get", "list"]}
  ]
}
---
{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "RoleBinding",
  "metadata": {"name": "workpartner-users", "namespace": {{namespace}}, "labels": {{partOf}}},
  "roleRef": {"apiGroup": "rbac.authorization.k8s.io", "kind": "Role", "name": "workpartner-users"},
  "subjects": [{"kind": "ServiceAccount", "name": {{gatewayName}}, "namespace": {{systemNamespace}}}]
}
---
{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {"name": "workpartner-system", "namespace": {{systemNamespace}}, "labels": {{partOf}}},
  "rules": [
    {"apiGroups": [""], "resources": ["pods/exec"], "verbs": ["get", "create"]},
    {"apiGroups": [""], "resources": ["configmaps"], "resourceNames": [{{imageConfigMap}}], "verbs": ["get"]}
  ]
}
---
{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "RoleBinding",
  "metadata": {"name": "workpartner-system", "namespace": {{systemNamespace}}, "labels": {{partOf}}},
  "roleRef": {"apiGroup": "rbac.authorization.k8s.io", "kind": "Role", "name": "workpartner-system"},
  "subjects": [{"kind": "ServiceAccount", "name": {{gatewayName}}, "namespace": {{systemNamespace}}}]
}
