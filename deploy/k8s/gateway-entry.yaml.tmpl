{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {"name": {{gatewayEntryName}}, "namespace": {{systemNamespace}}, "labels": {{partOf}}},
  "spec": {
    "type": "ClusterIP",
    "clusterIP": {{entryClusterIP}},
    "selector": {{gatewayLabels}},
    "ports": [{"name": "gateway", "protocol": "TCP", "port": {{gatewayPort}}, "targetPort": {{gatewayPort}}}]
  }
}
